generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// യൂസർ ഡാറ്റ സേവ് ചെയ്യാൻ (Master Admin, Admin, Student)
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("STUDENT") // 'MASTER_ADMIN', 'ADMIN', 'STUDENT'
  createdAt DateTime @default(now())
}

// ജർമൻ ലെവലുകൾ (A1, A2, B1 മുതലായവ)
model CourseLevel {
  id          String   @id @default(cuid())
  level       String   @unique
  title       String
  description String?
  lessons     Lesson[]
  createdAt   DateTime @default(now())
}

// അഡ്മിൻ ആഡ് ചെയ്യുന്ന പാഠങ്ങൾ
model Lesson {
  id            String      @id @default(cuid())
  title         String
  content       String?     // ഓപ്ഷണൽ: പാഠഭാഗം വിശദമായി എഴുതാൻ
  keyPoints     String?     // ഓപ്ഷണൽ: പോയിന്റുകൾ മാത്രം നൽകാൻ
  imageUrl      String?     // ഇമേജ് ലിങ്ക് സേവ് ചെയ്യാൻ
  videoUrl      String?     // വീഡിയോ ലിങ്ക്
  dayNumber     Int         @default(1) // ഏത് ദിവസത്തെ പാഠമാണ് എന്ന് അറിയാൻ
  courseLevelId String
  courseLevel   CourseLevel @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

// പ്ലേസ്മെന്റ് ടെസ്റ്റ് ചോദ്യങ്ങൾ സേവ് ചെയ്യാൻ
model Question {
  id            String   @id @default(cuid())
  question      String
  options       String[]
  correctString String?  
  correctAnswer String
  createdAt     DateTime @default(now())
}